# 数据库路径（默认：data/sequoia_v2.db）
DB_PATH=data/sequoia_v2.db

# 数据起始日期（默认：2024-01-01）
START_DATE=2024-01-01

# 默认飞书 Webhook URL（必填，作为 fallback）
FEISHU_WEBHOOK_URL=https://open.feishu.cn/open-apis/bot/v2/hook/your-default-token

# 策略专属 Webhook（可选，格式：STRATEGY_WEBHOOK_<策略标识>=<URL>）
# 未配置的策略将自动使用默认 FEISHU_WEBHOOK_URL
STRATEGY_WEBHOOK_MA_VOLUME=https://open.feishu.cn/open-apis/bot/v2/hook/your-ma-volume-token
STRATEGY_WEBHOOK_TURTLE=https://open.feishu.cn/open-apis/bot/v2/hook/your-turtle-token
STRATEGY_WEBHOOK_FLAG=https://open.feishu.cn/open-apis/bot/v2/hook/your-flag-token
STRATEGY_WEBHOOK_SHAKEOUT=https://open.feishu.cn/open-apis/bot/v2/hook/your-shakeout-token
STRATEGY_WEBHOOK_LIMIT_DOWN=https://open.feishu.cn/open-apis/bot/v2/hook/your-limit-down-token
STRATEGY_WEBHOOK_RPS=https://open.feishu.cn/open-apis/bot/v2/hook/your-rps-token
STRATEGY_WEBHOOK_PRIVATE_PLACEMENT=https://open.feishu.cn/open-apis/bot/v2/hook/your-private-placement-token

# ── LLM Top5 rerank (write_daily_picks / close_pm) ──
# Switch: 1=on (default in run_close_pm.sh). Missing key → source=rule_order fallback.
LLM_RERANK=1
LLM_API_KEY=
LLM_BASE_URL=https://api.tu-zi.com/v1
LLM_MODEL=gpt-6-astra
LLM_TIMEOUT_S=150
# LLM_TEMPERATURE=0.3

# Extra attempts on LLM read/request timeout before rule_order (0-2)
LLM_TIMEOUT_RETRIES=2

# ── Top5 pick mode (write_daily_picks / close_pm) ──
# llm | multi_hit | rule_order | shadow
# shadow (recommended Phase1 default): main calendar still llm/rule_order;
#   also writes data/daily_picks/_shadow/YYYY-MM-DD.multi_hit.json (NOT pushed to CF).
# (see block below) PICK_MODE moved
# Signal-day K coverage gate: skip writing picks + alert if below (Phase0).
# (see block below) MIN_VALID_STOCKS moved

# ── Top5 pick mode (write_daily_picks / close_pm) — 序5+序2 2026-10-02 ──
# llm | multi_hit | shadow (default). Unknown → shadow.
# shadow: main calendar stays LLM dual-model Top5; ALSO writes
#   data/daily_picks/_shadow/YYYY-MM-DD.multi_hit.json (source=multi_hit, track=multi_hit_shadow).
#   Shadow is NEVER pushed to CF / watch_calendar live Top5 / latest home picks.
PICK_MODE=shadow
# Hard kill-switch for cutting MAIN path to multi_hit. Default OFF.
# PICK_MODE=multi_hit is ignored (forced to shadow) unless this is 1.
ALLOW_MULTI_HIT_MAIN=0
# Legacy dual-track calendar UI switch (do not reintroduce removed UI). Keep 0.
MULTI_HIT_ENABLED=0
# Signal-day K coverage gate (序2): skip normal Top5 + write coverage_fail marker if below.
MIN_VALID_STOCKS=4000
