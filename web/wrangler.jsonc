{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "sequoia-x-web",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-05",
  "limits": {
    "cpu_ms": 300000
  },
  // account_id 已移除：部署时设置环境变量 CLOUDFLARE_ACCOUNT_ID，或在此填写 "account_id": "<CLOUDFLARE_ACCOUNT_ID>",
  "workers_dev": true,
  "r2_buckets": [
    {
      "binding": "PICKS",
      "bucket_name": "sequoia-x"
    }
  ]
}
